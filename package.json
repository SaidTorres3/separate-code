{
  "version": "4.0.0",
  "name": "separate-code",
  "displayName": "Separate Code",
  "publisher": "SaidTorres3",
  "author": {
    "name": "SaidTorres3",
    "email": "sesaid17@hotmail.com",
    "url": "https://github.com/SaidTorres3"
  },
  "description": "Enables you to effortlessly extract portions of your code and edit them in a dedicated, synchronized tab. Experience real-time updates as your extracted code stays in sync with its original source, making code manipulation and refactoring a seamless and efficient process.",
  "icon": "icon.png",
  "repository": {
    "url": "https://github.com/SaidTorres3/separate-code"
  },
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      { "id": "separate-javascript", "aliases": ["Separate JavaScript"] },
      { "id": "separate-typescript", "aliases": ["Separate TypeScript"] },
      { "id": "separate-php", "aliases": ["Separate PHP"] },
      { "id": "separate-css", "aliases": ["Separate CSS"] },
      { "id": "separate-scss", "aliases": ["Separate SCSS"] },
      { "id": "separate-less", "aliases": ["Separate Less"] },
      { "id": "separate-json", "aliases": ["Separate JSON"] },
      { "id": "separate-html", "aliases": ["Separate HTML"] }
    ],
    "grammars": [
      { "language": "separate-javascript", "scopeName": "source.separate.javascript", "path": "./syntaxes/separate-javascript.tmLanguage.json" },
      { "language": "separate-typescript", "scopeName": "source.separate.typescript", "path": "./syntaxes/separate-typescript.tmLanguage.json" },
      { "language": "separate-php", "scopeName": "source.separate.php", "path": "./syntaxes/separate-php.tmLanguage.json" },
      { "language": "separate-css", "scopeName": "source.separate.css", "path": "./syntaxes/separate-css.tmLanguage.json" },
      { "language": "separate-scss", "scopeName": "source.separate.scss", "path": "./syntaxes/separate-scss.tmLanguage.json" },
      { "language": "separate-less", "scopeName": "source.separate.less", "path": "./syntaxes/separate-less.tmLanguage.json" },
      { "language": "separate-json", "scopeName": "source.separate.json", "path": "./syntaxes/separate-json.tmLanguage.json" },
      { "language": "separate-html", "scopeName": "text.separate.html", "path": "./syntaxes/separate-html.tmLanguage.json" }
    ],
    "commands": [
      {
        "command": "extension.separate",
        "title": "✂️ Separate Code",
        "category": "Editor"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasSelection",
          "command": "extension.separate",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "extension.separate",
        "key": "ctrl+alt+shift+s",
        "when": "editorTextFocus && editorHasSelection",
        "mac": "cmd+alt+shift+s"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.2",
    "@types/node": "18.x",
    "@types/vscode": "^1.83.0",
    "@typescript-eslint/eslint-plugin": "^6.7.3",
    "@typescript-eslint/parser": "^6.7.3",
    "@vscode/test-electron": "^2.3.4",
    "eslint": "^8.50.0",
    "glob": "^10.3.3",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.4",
    "typescript": "^5.2.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "overrides": {
    "serialize-javascript": "^7.0.7"
  }
}
